{
	"name": "markingman/templator",
    "description": "Simple PHP server-side template system.",
    "type": "library",
    "require": {
        "php": ">=8.2"
    },
	"config": {
        "vendor-dir": "vendor"
    },
    "require-dev": {
		"phpunit/phpunit": "~11.4.2",
		"phpstan/phpstan": "~1.12"
	},
    "autoload": {
        "psr-4": {
            "Templator\\": ["src/", "tests/"]
        }
    }
}
