{
  "name": "markingman/templator",
  "description": "Lightweight PHP server-side template system.",
  "license": "MIT",
  "type": "library",
  "require": {
    "php": ">=8.3"
  },
  "autoload": {
    "psr-4": {
      "Templator\\": [
        "src/"
      ]
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Templator\\": [
        "tests/unit/"
      ]
    }
  },
  "require-dev": {
    "phpunit/phpunit": "~12.5",
    "phpstan/phpstan": "~2.1.22"
  },
  "config": {
    "vendor-dir": "vendor"
  }
}
