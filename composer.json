{
  "name": "markingman/templator",
  "description": "Simple PHP server-side template system.",
  "license": "MIT",
  "type": "library",
  "require": {
    "php": ">=8.2"
  },
  "autoload": {
    "psr-4": {
      "Templator\\": [
        "src/",
        "tests/"
      ]
    }
  },
  "require-dev": {
    "phpunit/phpunit": "~11.4.2",
    "phpstan/phpstan": "~1.12"
  },
  "config": {
    "vendor-dir": "vendor"
  }
}
